#!/bin/bash
# Start Project NOMAD (mounts the datastore if needed, via the unit's BindsTo) and wait for the
# admin to answer.
set -uo pipefail
. /usr/local/lib/nomad/common.sh
need_root "$@"

READY_TIMEOUT=${READY_TIMEOUT:-1800}

# A mount whose device vanished (surprise unplug) blocks a fresh mount; clear it.
if mountpoint -q "$NOMAD_MNT"; then
  src=$(findmnt -no SOURCE "$NOMAD_MNT")
  if [[ -n $src && ! -b $src ]]; then
    warn "Stale mount on $NOMAD_MNT (device $src is gone); detaching"
    umount -l "$NOMAD_MNT"
  fi
fi

systemctl start project-nomad.service || {
  systemctl --no-pager --lines=20 status project-nomad.service
  die "project-nomad.service failed to start"
}

info "Waiting for the admin at $NOMAD_ADMIN_URL (first start on a host may load the image archive)"
deadline=$((SECONDS + READY_TIMEOUT))
until curl -fsS -o /dev/null "$NOMAD_ADMIN_URL/api/health"; do
  if ! systemctl is-active --quiet project-nomad.service; then
    journalctl --no-pager -n 30 -u project-nomad.service
    die "project-nomad.service failed; see the log above"
  fi
  ((SECONDS < deadline)) || die "Admin not healthy after ${READY_TIMEOUT}s; check: journalctl -u project-nomad -f"
  sleep 5
done

info "NOMAD is up: $NOMAD_ADMIN_URL"
if [[ $(. "$NOMAD_HOST_CONF" 2>/dev/null; echo "${EXPOSE:-lan}") == lan ]]; then
  # `ip`, not `hostname -i`: inetutils is not in a base install (the backup OS has no hostname binary).
  for ip in $(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1); do
    [[ $ip == 172.1[6-9].* || $ip == 172.2[0-9].* || $ip == 172.3[01].* ]] && continue   # docker bridges
    info "LAN: http://$ip:8080"
  done
fi
